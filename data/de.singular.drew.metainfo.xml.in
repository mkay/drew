<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>de.singular.drew</id>

  <name>Drew</name>
  <summary>Image annotation for Wayland. Bells and whistles included</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      Open an image or pipe one in and add arrows, shapes, text, numbered
      markers, spotlight, blur and pixelate, or crop it. Everything stays
      movable and resizable until you save.
    </p>
    <p>
      Drew captures nothing itself — it takes its image from grim, wl-paste
      or any other tool, on the command line or via stdin, and saves to a
      file, to stdout or to the clipboard.
    </p>
  </description>

  <launchable type="desktop-id">de.singular.drew.desktop</launchable>

  <url type="homepage">https://github.com/mkay/drew</url>

  <developer id="de.singular">
    <name>Kreuder</name>
  </developer>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2026-09-15">
      <description>
        <p>Initial skeleton: open an image from a file or stdin, save as PNG.</p>
      </description>
    </release>
  </releases>
</component>
